{
  "name": "@librechat/chat",
  "version": "0.1.0",
  "private": true,
  "description": "Chat state, transport and message components for LibreChat",
  "repository": {
    "type": "git",
    "url": "https://github.com/LibreChat-AI/LibreChat"
  },
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components.d.mts",
        "default": "./dist/components.mjs"
      },
      "require": {
        "types": "./dist/components.d.cts",
        "default": "./dist/components.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "b:clean": "bun run rimraf dist",
    "build": "npm run clean && tsdown",
    "b:build": "bun run b:clean && bun run tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "node ../../scripts/typecheck.mts && node ../../scripts/typecheck.mts -p test/tsconfig.json",
    "test": "jest",
    "test:ci": "jest --ci"
  },
  "peerDependencies": {
    "@ariakit/react": "^0.4.29",
    "@librechat/client": "*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^4.28.0",
    "framer-motion": "^12.40.0",
    "jotai": "^2.12.5",
    "librechat-data-provider": "*",
    "lucide": "^0.528.0",
    "lucide-react": "^0.528.0",
    "mdast-util-directive": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.1",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-directive": "^3.0.1",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "react": "^18.2.0 || ^19.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0 || ^19.1.0",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "sse.js": "^2.8.0"
  },
  "devDependencies": {
    "@ariakit/react": "^0.4.43",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@librechat/client": "*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^4.44.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "babel-plugin-replace-ts-export-assignment": "^0.0.2",
    "framer-motion": "^12.43.0",
    "i18next": "^24.2.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jotai": "^2.20.3",
    "librechat-data-provider": "*",
    "lucide": "^0.528.0",
    "lucide-react": "^0.528.0",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-directive": "^3.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "rimraf": "^6.1.4",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "uuid": "^11.1.1"
  }
}
